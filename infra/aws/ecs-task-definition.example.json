{
  "family": "resource-service",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::YOUR_ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::YOUR_ACCOUNT_ID:role/resourceServiceTaskRole",
  "containerDefinitions": [
    {
      "name": "resource-service",
      "image": "YOUR_ACCOUNT_ID.dkr.ecr.YOUR_AWS_REGION.amazonaws.com/resource-service:bootstrap",
      "essential": true,
      "portMappings": [{"containerPort": 4001, "protocol": "tcp"}],
      "environment": [
        {"name": "PORT", "value": "4001"},
        {"name": "FRONTEND_URL", "value": "https://YOUR_CLOUDFRONT_DOMAIN"},
        {"name": "DATABASE_SSL", "value": "true"},
        {"name": "COGNITO_USER_POOL_ID", "value": "YOUR_USER_POOL_ID"},
        {"name": "COGNITO_CLIENT_ID", "value": "YOUR_COGNITO_APP_CLIENT_ID"},
        {"name": "DB_POOL_MAX", "value": "10"}
      ],
      "secrets": [
        {"name": "DATABASE_URL", "valueFrom": "YOUR_SECRETS_MANAGER_DATABASE_URL_SECRET_ARN"}
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "node -e \"fetch('http://127.0.0.1:4001/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\""],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/resource-service",
          "awslogs-region": "YOUR_AWS_REGION",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
