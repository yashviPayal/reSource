PORT=4003
NODE_ENV=development

# Database credentials for local Docker Compose
DB_USER=claim_user
DB_PASSWORD=claim_dev_password
DB_NAME=claim_db
DB_PORT=5435

# PostgreSQL connection string:
# Option A: Local standalone docker-compose
DATABASE_URL=postgresql://claim_user:claim_dev_password@localhost:5435/claim_db
# Option B: Managed Supabase DB
# DATABASE_URL=postgresql://postgres.xxx:your_password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=false
DB_POOL_MAX=10

# Shared JWT secret for verifying auth-service tokens
JWT_SECRET=super_secret_jwt_key_replace_in_production_2026

# Downstream Resource Service URL
RESOURCE_SERVICE_URL=http://localhost:4001

# CORS client origin (frontend or api-gateway)
CLIENT_URL=http://localhost:5173,http://localhost:4000
