PORT=4002
NODE_ENV=development

# Database credentials (used by docker-compose)
DB_USER=auth_user
DB_PASSWORD=your_secure_db_password
DB_NAME=auth_db
DB_PORT=5434

# PostgreSQL connection string:
# Option A: Local standalone docker-compose
DATABASE_URL=postgresql://auth_user:your_secure_db_password@localhost:5434/auth_db
# Option B: Managed Supabase DB
# DATABASE_URL=postgresql://postgres.xxxx:your_supabase_password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=false
DB_POOL_MAX=10

# JWT configuration (keep secret out of git)
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_here
JWT_EXPIRES_IN=7d

# CORS client origin
CLIENT_URL=http://localhost:5173
